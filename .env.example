# API
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@host:5432/database

# Production identity adapter
# Required when NODE_ENV=production. Must be the exact public HTTPS origin
# that serves BOTH the built web app and /v1/* API (no path/query/fragment).
APP_ORIGIN=https://app.example.com
# Required in production. Generate a high-entropy secret; never commit the real value.
CSRF_SECRET=replace-with-at-least-32-random-characters

# Versioned session policy
SESSION_ABSOLUTE_TTL_SECONDS=2592000
SESSION_IDLE_TTL_SECONDS=86400

# Versioned login-throttle policy
LOGIN_RATE_WINDOW_SECONDS=900
LOGIN_MAX_EMAIL_FAILURES=5
LOGIN_MAX_IP_FAILURES=50

# Argon2id baseline policy (OWASP-listed profile used by Identity v1 design)
ARGON2_MEMORY_COST_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
ARGON2_HASH_LENGTH=32

# Issue #26 YouTube connector (optional as a group; routes fail closed if absent).
# Configure real values only in the secret manager / Railway variables.
YOUTUBE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
YOUTUBE_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret
# Base64url encoding of exactly 32 random bytes, used for AES-256-GCM provider credential encryption.
PROVIDER_CREDENTIALS_KEY_B64URL=replace-with-32-byte-base64url-key
PROVIDER_CREDENTIALS_KEY_VERSION=v1
# MUST remain false until YouTube's Analytics & Reporting derived-metrics use case is formally accepted and documented.
YOUTUBE_DERIVED_ANALYTICS_POLICY_ACCEPTED=false

# Web Opportunity Radar
# Development only. In a production Vite build the client mechanically ignores
# VITE_API_BASE_URL and calls the same origin served by the Fastify process.
VITE_API_BASE_URL=http://localhost:3000
# Development only. The web client sends these headers only when Vite is in DEV mode.
# Production ignores caller-supplied identity headers and authenticates via the server-side session adapter.
VITE_DEV_USER_ID=a0000000-0000-4000-8000-000000000001
VITE_DEV_WORKSPACE_ID=b0000000-0000-4000-8000-000000000001

# Integration tests only: use distinct credentials for each database role.
MIGRATOR_DATABASE_URL=postgresql://growth_migrator:password@host:5432/database
TEST_HARNESS_DATABASE_URL=postgresql://growth_test_harness:password@host:5432/database
APP_RUNTIME_DATABASE_URL=postgresql://app_runtime:password@host:5432/database
ADMIN_DATABASE_URL=postgresql://admin:password@host:5432/database
